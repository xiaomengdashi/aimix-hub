# Supabase（用户登录、会话持久化、后台模型/密钥配置）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 推荐使用 legacy service_role JWT（eyJ 开头）；sb_secret_ 格式可能报 Invalid API key
SUPABASE_SERVICE_ROLE_KEY=
# 若使用 sb_publishable + sb_secret 且 secret 无效，可从 /admin/models 复制此 token
# SUPABASE_SERVER_READ_TOKEN=

# AI 网关与 Tavily 密钥请在管理员后台 /admin/models 配置（不再使用环境变量）
